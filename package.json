{
    "name": "app",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev -p 8281",
        "build": "npm run typecheck && next build",
        "typecheck": "tsc -b",
        "start": "next start -H localhost -p 8281",
        "lint": "oxlint --max-warnings=0 --disable-nested-config .",
        "lint:fix": "oxlint --disable-nested-config . --fix",
        "format": "oxfmt --check ./app",
        "format:fix": "oxfmt ./app",
        "prepare": "husky"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "better-sqlite3": "^13.0.3",
        "bootstrap-icons": "^1.13.1",
        "chart.js": "^4.5.1",
        "fuse.js": "^7.5.0",
        "ioredis": "^6.0.0",
        "jsdom": "^30.0.1",
        "jsonwebtoken": "^9.0.3",
        "next": "16.3.3",
        "react": "19.2.8",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "19.2.8",
        "redis": "^6.2.1",
        "sass": "^1.103.1",
        "toad-scheduler": "^4.1.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/cloudflare-turnstile": "^0.2.2",
        "@types/jsdom": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0",
        "typescript": "7.0.2"
    },
    "lint-staged": {
        "app/**/*.{ts,tsx,js,jsx}": [
            "oxlint --disable-nested-config --fix",
            "oxfmt"
        ],
        "app/**/*.{css,scss,json,md}": [
            "oxfmt"
        ]
    },
    "overrides": {
        "postcss": "8.5.16"
    },
    "allowScripts": {
        "bcrypt@6.0.0": true,
        "sharp@0.34.5": true,
        "unrs-resolver@1.12.2": true,
        "@parcel/watcher@2.6.0": true,
        "better-sqlite3@13.0.3": true
    }
}
